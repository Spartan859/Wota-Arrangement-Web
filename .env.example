NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8080
DATABASE_URL=postgres://wota:change-me@postgres:5432/wota
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER_URL=http://127.0.0.1:8081/application/o/wota/
OIDC_DISCOVERY_URL=http://authentik-server:9000/application/o/wota/
OIDC_INTERNAL_BASE_URL=http://authentik-server:9000
OIDC_CLIENT_ID=wota-bff
OIDC_CLIENT_SECRET=replace-with-a-random-client-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8080/
AUDIO_STORAGE_DIR=/data/audio
DEFAULT_QUOTA_BYTES=104857600
MAX_AUDIO_BYTES=104857600
TRUST_PROXY=true
AUTHENTIK_ADMIN_BASE_URL=http://authentik-server:9000
AUTHENTIK_ADMIN_TOKEN=replace-with-a-random-admin-api-token
AUTHENTIK_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
AUTHENTIK_SECRET_KEY=replace-with-at-least-60-random-characters
AUTHENTIK_HOSTNAME=http://127.0.0.1:8081
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
# Production: set a password hash instead and remove the plaintext password.
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH=
AUTHENTIK_RECOVERY_EMAIL_STAGE=wota-recovery-email
AUTHENTIK_EMAIL__HOST=mailpit
AUTHENTIK_EMAIL__PORT=1025
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=no-reply@wota.satintin.com
POSTGRES_USER=wota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wota
SMTP_RELAY_HOST=smtp.example.com:587
SMTP_RELAY_USERNAME=replace-me
SMTP_RELAY_PASSWORD=replace-me
SMTP_ALLOWED_SENDER_DOMAINS=wota.satintin.com
SMTP_HELO_HOSTNAME=mail.wota.satintin.com
