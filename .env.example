NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8080
DATABASE_URL=postgres://wota:change-me@postgres:5432/wota
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER_URL=http://127.0.0.1:8081/realms/wota
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/wota
OIDC_INTERNAL_BASE_URL=http://keycloak:8080
OIDC_CLIENT_ID=wota-bff
OIDC_CLIENT_SECRET=replace-with-a-random-client-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8080/
AUDIO_STORAGE_DIR=/data/audio
DEFAULT_QUOTA_BYTES=104857600
MAX_AUDIO_BYTES=104857600
TRUST_PROXY=true
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_ADMIN_REALM=wota
KEYCLOAK_ADMIN_CLIENT_ID=wota-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-random-admin-client-secret
KEYCLOAK_HOSTNAME=http://127.0.0.1:8081
KEYCLOAK_BOOTSTRAP_USERNAME=admin
KEYCLOAK_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@wota.satintin.com
POSTGRES_USER=wota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wota
SMTP_RELAY_HOST=smtp.example.com:587
SMTP_RELAY_USERNAME=replace-me
SMTP_RELAY_PASSWORD=replace-me
SMTP_ALLOWED_SENDER_DOMAINS=wota.satintin.com
SMTP_HELO_HOSTNAME=mail.wota.satintin.com
