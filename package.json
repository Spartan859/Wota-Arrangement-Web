{
  "name": "wota-arrangement-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm run dev\" \"npm run dev:api\"",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build:api": "tsup server/index.ts server/db/migrate.ts server/scripts/create-admin.ts server/scripts/configure-keycloak.ts --format esm --platform node --target node22 --out-dir server-dist --clean --sourcemap",
    "build": "npm run typecheck && npm run build:api && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:api": "node server-dist/index.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "admin:create": "tsx server/scripts/create-admin.ts",
    "keycloak:configure": "tsx server/scripts/configure-keycloak.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format": "prettier --write src server tests scripts/*.mjs *.json *.ts *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src server tests scripts/*.mjs *.json *.ts *.html *.md .github/workflows/*.yml",
    "commit": "node scripts/auto-commit-push.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "dexie": "^4.4.6",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "music-metadata": "^11.16.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "exceljs": {
      "uuid": "^11.1.0"
    }
  }
}
