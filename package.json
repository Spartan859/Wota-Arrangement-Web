{
  "name": "wota-arrangement-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "format": "prettier --write src tests scripts/*.mjs *.json *.ts *.html *.md .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts/*.mjs *.json *.ts *.html *.md .github/workflows/*.yml",
    "commit": "node scripts/auto-commit-push.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.0"
    }
  }
}
